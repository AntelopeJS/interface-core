{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 2,
    "antelopejs/no-presence-only-type-guard": 2,
    "anti-slop/no-unknown-parameters": 2,
    "typescript/no-unsafe-argument": 14,
    "typescript/no-unsafe-assignment": 23,
    "typescript/no-unsafe-return": 7,
    "typescript/use-unknown-in-catch-callback-variable": 5
  },
  "oversizeFiles": {}
}
